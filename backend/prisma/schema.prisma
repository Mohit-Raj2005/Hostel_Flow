generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hostel {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String
  createdAt DateTime @default(now())

  users     User[]
  rooms     Room[]
  students  Student[]
  charges   Charge[]
  notices Notice[]
}

model User {
  id        String @id @default(uuid())
  name      String
  email     String @unique
  password  String
  mobNo     String
  role      Role
  isActive  Boolean  @default(true)

  hostelId  String
  hostel    Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  student   Student?
  createdAt DateTime @default(now())
}

model Student {
  id          String   @id @default(uuid())
  userId      String   @unique
  regNo       String
  hostelId    String
  roomId      String?
  joiningDate DateTime @default(now())

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room     Room?  @relation(fields: [roomId], references: [id])

  invoices   Invoice[]
  payments   PaymentTransaction[]
  complaints Complaint[]
  visitors   Visitor[]

  @@unique([hostelId, regNo])
}

model Room {
  id        String     @id @default(uuid())
  hostelId  String
  number    String
  capacity  Int
  occupancy Int        @default(0)
  status    RoomStatus @default(AVAILABLE)

  hostel   Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([hostelId, number])
}

/////////////////////////
// 🔹 CHARGE SYSTEM
/////////////////////////

model ChargeType {
  id          String @id @default(uuid())
  name        String @unique
  description String?

  charges Charge[]
}

model Charge {
  id           String   @id @default(uuid())
  hostelId     String
  chargeTypeId String

  baseAmount Int @default(0)

  frequency    ChargeFrequency
  interval     Int   

  startDate    DateTime
  endDate      DateTime?

  hostel     Hostel     @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeId], references: [id])

  invoices   Invoice[]
}



model Invoice {
  id        String   @id @default(uuid())
  studentId String
  chargeId  String

  totalAmount   Int
  paidAmount    Int      @default(0)
  remaining     Int

  dueDate       DateTime

  status        InvoiceStatus @default(PENDING)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charge  Charge  @relation(fields: [chargeId], references: [id])

  payments PaymentTransaction[]

  createdAt DateTime @default(now())
}



model PaymentTransaction {
  id         String   @id @default(uuid())
  studentId  String
  invoiceId  String

  amount     Int
  paidAt     DateTime @default(now())

  method     String?
  reference  String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}


model Complaint {
  id        String              @id @default(uuid())
  studentId String
  title     String          
  message   String             
  status    ComplaintStatus     @default(PENDING)
  priority  ComplaintPriority   @default(MEDIUM)

  createdAt DateTime            @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Visitor {
  id        String   @id @default(uuid())
  name      String
  studentId String
  purpose   String
  entryTime DateTime @default(now())
  exitTime  DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}


model Notice {
  id          String   @id @default(uuid())
  title       String
  description String
  type        NoticeType @default(GENERAL)
  isActive    Boolean  @default(true)

  hostelId    String
  hostel      Hostel   @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  createdBy   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  @@index([hostelId])
}


enum NoticeType {
  GENERAL
  URGENT
}

enum Role {
  ADMIN
  WARDEN
  STUDENT
}

enum RoomStatus {
  AVAILABLE
  FULL
  MAINTENANCE
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}


enum ChargeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}